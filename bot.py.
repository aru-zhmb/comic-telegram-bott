
import os
import time
import asyncio
import logging
from io import BytesIO

import requests
from telegram import Update, InputMediaPhoto
from telegram.ext import (
    Application,
    CommandHandler,
    MessageHandler,
    ContextTypes,
    filters,
)

BOT_TOKEN = os.getenv("BOT_TOKEN")
HORDE_API = "https://aihorde.net/api/v2"

logging.basicConfig(level=logging.INFO)
log = logging.getLogger(__name__)


def generate_image(prompt: str) -> bytes:
    headers = {
        "apikey": "0000000000",
        "Client-Agent": "comic-telegram-bott:1.0",
        "Content-Type": "application/json",
    }

    payload = {
        "prompt": prompt,
        "params": {
            "width": 512,
            "height": 512,
            "steps": 20,
            "n": 1,
        },
        "models": ["stable_diffusion"],
    }

    response = requests.post(
        f"{HORDE_API}/generate/async",
        headers=headers,
        json=payload,
        timeout=60,
    )
    response.raise_for_status()
    job_id = response.json()["id"]

    for _ in range(120):
        time.sleep(3)

        response = requests.get(
            f"{HORDE_API}/generate/status/{job_id}",
            headers=headers,
            timeout=30,
        )
        response.raise_for_status()
        result = response.json()

        if result.get("fault"):
            raise RuntimeError(str(result["fault"]))

        if result.get("done"):
            generations = result.get("generations", [])
            if not generations:
                raise RuntimeError("No images returned")

            image_url = generations[0].get("img", "")

            if image_url.startswith("http"):
                image_response = requests.get(
                    image_url, timeout=60
                )
                image_response.raise_for_status()
                return image_response.content

            raise RuntimeError("Image URL was not returned")

    raise TimeoutError("Image generation timed out")


def make_prompt(story: str, number: int) -> str:
    scenes = [
        "Introduce the main character and setting.",
        "The character discovers something unusual.",
        "The character begins an adventure.",
        "An unexpected problem appears.",
        "The character finds a solution.",
        "Show a satisfying ending.",
    ]

    return (
        "One panel of a six-panel comic book, colorful detailed "
        "illustration, expressive characters, cinematic composition, "
        "clear readable visual storytelling, no words, no text, "
        "no letters, no speech bubbles. Keep the character design "
        "consistent across panels. "
        f"Story: {story}. "
        f"Panel {number} of 6: {scenes[number - 1]}"
    )


async def start(
    update: Update, context: ContextTypes.DEFAULT_TYPE
):
    await update.message.reply_text(
        "Привет! 🎨 Я создаю комиксы из 6 кадров.\n\n"
        "Отправь мне сюжет одним сообщением.\n"
        "Например: Девочка находит волшебный лес.\n\n"
        "/help — помощь"
    )


async def help_command(
    update: Update, context: ContextTypes.DEFAULT_TYPE
):
    await update.message.reply_text(
        "Напиши сюжет на русском, казахском или другом языке. "
        "Я попробую создать 6 кадров. Генерация может занять "
        "несколько минут и зависит от доступности бесплатных моделей."
    )


async def generate_comic(
    update: Update, context: ContextTypes.DEFAULT_TYPE
):
    story = update.message.text.strip()

    if len(story) < 5:
        await update.message.reply_text(
            "Напиши сюжет чуть подробнее."
        )
        return

    if len(story) > 1200:
        await update.message.reply_text(
            "Сократи сюжет до 1200 символов и попробуй снова."
        )
        return

    status = await update.message.reply_text(
        "📖 Получила сюжет!\n"
        "🎨 Создаю 6 кадров. Пожалуйста, подожди..."
    )

    try:
        images = []

        for number in range(1, 7):
            await status.edit_text(
                f"🎨 Создаю кадр {number}/6. Подожди..."
            )

            prompt = make_prompt(story, number)
            image_bytes = await asyncio.to_thread(
                generate_image, prompt
            )
            images.append(image_bytes)

        await status.edit_text(
            "✅ Кадры готовы! Отправляю комикс..."
        )

        for start_index in range(0, 6, 3):
            media = []

            for index in range(
                start_index, min(start_index + 3, 6)
            ):
                photo = BytesIO(images[index])
                photo.name = f"panel_{index + 1}.png"

                media.append(
                    InputMediaPhoto(
                        media=photo,
                        caption=f"Кадр {index + 1}/6"
                    )
                )

            await update.message.reply_media_group(
                media=media
            )

        await status.edit_text(
            "🎉 Готово! Твой комикс состоит из 6 кадров."
        )

    except Exception:
        log.exception("Comic generation failed")
        await status.edit_text(
            "Не получилось создать комикс 😔\n"
            "Возможно, бесплатная очередь перегружена. "
            "Попробуй ещё раз позже."
        )


def main():
    if not BOT_TOKEN:
        raise RuntimeError(
            "Не задан BOT_TOKEN в переменных окружения."
        )

    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            generate_comic
        )
    )

    app.run_polling()


if __name__ == "__main__":
    main()
